# .env.example — docker compose 环境变量模板（文件管理详设 8.2）
# 使用：cp .env.example .env，按需修改；.env 已被 .gitignore 排除，真实凭据禁止入库。
# 以下均为可用的示例值，对外暴露前必须全部更换。

# ---- PostgreSQL ----
POSTGRES_USER=robotest
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=robotest

# ---- Redis（server 连接口令，须与下方 compose 服务一致） ----
REDIS_PASSWORD=change-me-redis

# ---- SeaweedFS 对象存储（S3 兼容） ----
S3_ACCESS_KEY=robotest
S3_SECRET_KEY=change-me-s3
S3_BUCKET=robotest
# presigned 签名地址：浏览器可达的宿主地址（compose 内部网地址浏览器无法直连，详设 3.1）
S3_PUBLIC_ENDPOINT=http://localhost:9000

# ---- 应用密钥（生产必须更换；ENV_SECRET_KEY 为 Base64 编码 32 字节） ----
ENV_SECRET_KEY=Zc3eHGXLKJd9TP4MA2oAQ66NlCpQmaZ2UQpCsoDOFjA=
JWT_SECRET_KEY=99ab342e4fa26206b2f337dae2e7e20a07c5422e20b11574
PASSWORD_SECRET=c1afa1705770dd80dbf7f6daba1fd92e
