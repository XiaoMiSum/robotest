# RoboTest 后端本地环境变量模板
# 使用方式：复制为 server/.env，按本机 PostgreSQL、Redis 和密钥配置替换。
# server/.env 已被 Git 忽略；禁止将真实凭据提交到仓库。

# Spring / HTTP
SPRING_PROFILES_ACTIVE=dev
PORT=58080
DEBUG_STATUS=false

# PostgreSQL
DATABASE_DRIVER=org.postgresql.Driver
DATASOURCE_URL=jdbc:postgresql://localhost:5432/robotest?stringtype=unspecified
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=replace-with-local-database-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=replace-with-local-redis-password

# 文件上传
UPLOAD_DIR=./uploads/bug

# 安全配置：各密钥域必须使用不同值，不得复用到测试或生产环境
# AI_SECRET_KEY / ENV_SECRET_KEY 使用 Base64 编码的 32 字节随机值
AI_SECRET_KEY=replace-with-unique-base64-32-byte-key
ENV_SECRET_KEY=replace-with-another-unique-base64-32-byte-key
JWT_SECRET_KEY=replace-with-unique-jwt-secret-at-least-32-bytes
PASSWORD_SECRET=replace-with-unique-password-service-secret

# API 测试与 Mock
IMPORT_URL_POLICY=intranet
MOCK_ACCESS_ENABLED=true
MOCK_PORT=18080
MOCK_BASE_URL=http://localhost:18080
MOCK_PATH_QPS=50

# 调度器
SCHEDULER_POOL_SIZE=2
TASK_EXECUTION_TIMEOUT_MINUTES=30
TASK_POLL_INTERVAL_MS=5000
